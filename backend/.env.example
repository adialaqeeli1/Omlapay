# Backend settings. Copy to backend/.env (./run.sh does this for you and fills in the secrets).
# Never commit backend/.env.

# --- Required to start ------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Local database. ./run.sh starts a matching Postgres in Docker on port 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=omlapay
POSTGRES_USER=omlapay
POSTGRES_PASSWORD=omlapay

# Login tokens. JWT_SECRET_KEY: any long random string.
JWT_SECRET_KEY=change-me
JWT_EXP_TIME=1h
JWT_REFRESH_EXP_TIME=7d

# Encrypts sensitive database fields. Must be 64 hex characters (openssl rand -hex 32).
# Keep it forever for a given database: changing it makes existing encrypted data unreadable.
FIELD_ENCRYPTION_KEY=

# Login for the API docs page at http://localhost:3000/docs
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-me

# --- Links used in emails and responses ----------------------------------------------------------
API_BASE_URL=http://localhost:3000
APP_INVITE_URL=
SUPPORT_EMAIL=
# Browser origins allowed to call the API, comma-separated. Empty allows any origin.
CORS_ORIGINS=
# Countries whose mobile numbers may receive OTP codes (calling codes, comma-separated). Default 966.
ALLOWED_PHONE_COUNTRY_CODES=966
# Number of reverse proxies in front of the backend (1 behind Caddy). 0 when called directly.
TRUST_PROXY_HOPS=0

# --- Integrations: only needed for the features that use them ------------------------------------
# File uploads (support attachments, KYC documents)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
# Only for S3-compatible storage (Garage, Cloudflare R2), e.g. http://garage:3900
S3_ENDPOINT=

# Email (OTP and notifications): Postmark when POSTMARK_SERVER_TOKEN is set, else Mailgun when
# configured, else switched off (emails are only logged).
POSTMARK_SERVER_TOKEN=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=OmlaPay
POSTMARK_MESSAGE_STREAM=outbound
MAILGUN_API_KEY=
MAILGUN_BASE_URL=
MAILGUN_SANDBOX_DOMAIN=

# SMS and email through Taqnyat
TAQNYAT_API_URL=
TAQNYAT_API_KEY=
TAQNYAT_BEARER_TOKEN=
TAQNYAT_SENDER_NAME=
TAQNYAT_FROM_EMAIL=
TAQNYAT_FROM_NAME=

# KYC through Sumsub
SUMSUB_BASE_URL=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_DEFAULT_LEVEL_NAME=

# Trading, wallets and KYC through Binance
BINANCE_API_BASE_URL=
BINANCE_API_KEY=
BINANCE_API_PRIVATE_KEY_PEM=
BINANCE_RECV_WINDOW=
BINANCE_BROKER_MAIN_ACCOUNT_ID=
BINANCE_DEV_SUBACCOUNT_EMAIL=
BINANCE_DEV_SUBACCOUNT_ID=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_PRIVATE_KEY_PEM=
BINANCE_KYC_BASE_URL=
BINANCE_KYC_BIZ_ENTITY_KEY=
BINANCE_KYC_SECRET=
