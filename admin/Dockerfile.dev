# Development Dockerfile for Vite + React + TypeScript
FROM node:20-alpine
WORKDIR /app
RUN npm i -g pnpm
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
EXPOSE 5173
# Run install at startup so node_modules volume gets populated (mount overwrites build's node_modules)
CMD ["sh", "-c", "pnpm install && pnpm dev --host 0.0.0.0 --port 5173"]

