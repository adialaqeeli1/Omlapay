# Settings for ONE app stack. Copy to deploy/.env in that stack's checkout and fill it in there.
#   Production: /home/deploy/app/deploy/.env      (branch main)
#   Dev:        /home/deploy/app-dev/deploy/.env  (branch develop)
# Never commit deploy/.env. Keep values free of "$" (use hex: openssl rand -hex 32).
# Lines marked [prod] / [dev] show the value for each stack; everything else is a secret or
# an account value you fill in yourself.

# --- Stack identity ----------------------------------------------------------------------------
# [prod] omlapay-prod   [dev] omlapay-dev
COMPOSE_PROJECT_NAME=omlapay-prod
# [prod] prod           [dev] dev
STACK=prod
# [prod] admin (also builds and runs the admin panel)   [dev] leave empty
COMPOSE_PROFILES=admin

# --- Backend mode ------------------------------------------------------------------------------
# [prod] production     [dev] staging
# staging: OTP codes are not returned in responses and are not sent by SMS either; they are
# written to the backend log (docker compose -f deploy/docker-compose.yml logs backend).
# Never use "development" on a public server: it returns OTP codes in API responses.
NODE_ENV=production

# --- Phone numbers and rate limiting -----------------------------------------------------------
# Countries whose mobile numbers may receive OTP codes and be set on accounts (comma-separated
# calling codes). 966 = Saudi Arabia: +9665XXXXXXXX only; 05XXXXXXXX etc. are normalized.
ALLOWED_PHONE_COUNTRY_CODES=966
# Caddy is the one proxy in front of the backend: needed so rate limits see the real client IP.
TRUST_PROXY_HOPS=1

# --- Database (this stack only) ----------------------------------------------------------------
POSTGRES_DB=omlapay
POSTGRES_USER=omlapay
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# --- Login tokens and encryption ---------------------------------------------------------------
# openssl rand -hex 32   (different for prod and dev)
JWT_SECRET_KEY=CHANGE_ME
JWT_EXP_TIME=1h
JWT_REFRESH_EXP_TIME=7d
# openssl rand -hex 32   Keep it forever for this database: changing it makes encrypted data unreadable.
FIELD_ENCRYPTION_KEY=CHANGE_ME

# --- API docs login (/docs on this stack's API; the only password on the API docs) --------------
SWAGGER_USER=CHANGE_ME
# openssl rand -hex 16
SWAGGER_PASSWORD=CHANGE_ME

# --- Public URLs -------------------------------------------------------------------------------
# [prod] https://api.omlapay.org   [dev] https://api-dev.omlapay.org
API_BASE_URL=https://api.omlapay.org
APP_INVITE_URL=
SUPPORT_EMAIL=
# Browsers allowed to call the API (comma-separated).
# [prod] https://admin.omlapay.org   [dev] leave empty (any origin)
CORS_ORIGINS=https://admin.omlapay.org

# --- Admin panel build (prod only; ignored when COMPOSE_PROFILES is empty) -----------------------
ADMIN_VITE_API_URL=https://api.omlapay.org
ADMIN_VITE_API_BASE_URL=https://api.omlapay.org/v1

# --- File uploads: Garage on this server (S3-compatible) ---------------------------------------
# The backend reaches Garage at http://garage:3900 (set in docker-compose.yml; region "garage").
# To move to Cloudflare R2 later: see DEPLOY.md (File storage); no code change needed.
# Garage cluster secret: openssl rand -hex 32
GARAGE_RPC_SECRET=CHANGE_ME
# The app's storage key, imported into Garage by deploy/scripts/garage-init.sh:
#   AWS_ACCESS_KEY_ID:     echo GK$(openssl rand -hex 12)
#   AWS_SECRET_ACCESS_KEY: openssl rand -hex 32
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# [prod] omlapay-prod-uploads   [dev] omlapay-dev-uploads  (must match the Caddyfile)
S3_BUCKET_NAME=omlapay-prod-uploads
# [prod] https://files.omlapay.org   [dev] https://files-dev.omlapay.org
S3_PUBLIC_URL=https://files.omlapay.org
# Disk space Garage may use on this server
GARAGE_CAPACITY=20G

# --- Email (OTP and notifications) -------------------------------------------------------------
# Postmark is used when POSTMARK_SERVER_TOKEN is set. Leave it empty (and the MAILGUN_* values
# empty) to switch email off: see DEPLOY.md (Email) for what then does not work.
# Server API token: Postmark -> Servers -> your server -> API Tokens
POSTMARK_SERVER_TOKEN=
# Sender address on a domain (or single sender signature) verified in Postmark
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=OmlaPay
# Transactional message stream ID ("outbound" is Postmark's default)
POSTMARK_MESSAGE_STREAM=outbound
# Mailgun (optional): used only when POSTMARK_SERVER_TOKEN is empty
MAILGUN_API_KEY=
MAILGUN_BASE_URL=
MAILGUN_SANDBOX_DOMAIN=

# --- SMS and email through Taqnyat ---------------------------------------------------------------
TAQNYAT_API_URL=
TAQNYAT_API_KEY=
TAQNYAT_BEARER_TOKEN=
TAQNYAT_SENDER_NAME=
TAQNYAT_FROM_EMAIL=
TAQNYAT_FROM_NAME=

# --- KYC through Sumsub ------------------------------------------------------------------------
# Webhook URL to set in Sumsub: <API_BASE_URL>/v1/user/webhooks/sumsub
SUMSUB_BASE_URL=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_DEFAULT_LEVEL_NAME=

# --- Binance -----------------------------------------------------------------------------------
# Webhook URL to set in Binance KYC: <API_BASE_URL>/v1/user/webhooks/binance-kyc
# PEM keys go on ONE line in double quotes, with \n where the line breaks are:
#   BINANCE_API_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
BINANCE_API_BASE_URL=
BINANCE_API_KEY=
BINANCE_API_PRIVATE_KEY_PEM=
BINANCE_RECV_WINDOW=
BINANCE_BROKER_MAIN_ACCOUNT_ID=
BINANCE_DEV_SUBACCOUNT_EMAIL=
BINANCE_DEV_SUBACCOUNT_ID=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_PRIVATE_KEY_PEM=
BINANCE_KYC_BASE_URL=
BINANCE_KYC_BIZ_ENTITY_KEY=
BINANCE_KYC_SECRET=
