# Off-server backups: restic to the private Cloudflare R2 bucket "omlapay-backups".
# Copy to /home/deploy/backup.env (outside the checkouts) and run: chmod 600 /home/deploy/backup.env
# Docker reads this file as-is: no quotes, no comments at the end of a line.

# https://<ACCOUNT_ID>.r2.cloudflarestorage.com with /omlapay-backups at the end
RESTIC_REPOSITORY=s3:https://CHANGE_ME.r2.cloudflarestorage.com/omlapay-backups

# Encryption password for the backups: openssl rand -hex 32
# Keep a copy OFF the server (password manager). Without it the backups cannot be read.
RESTIC_PASSWORD=CHANGE_ME

# R2 API token limited to the omlapay-backups bucket (Object Read & Write)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=auto
